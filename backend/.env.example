DB_HOST=localhost
DB_USER=hyghncjr_bukea_app
# Si la contraseña tiene #, ponla entre comillas — dotenv corta el valor en un # sin comillas
DB_PASSWORD=""
DB_NAME=hyghncjr_bukea

# Prefijo de ruta bajo el que se monta la app (en producción: /app → https://www.bukeard.com/app/)
BASE_PATH=/bukea

# Login con Google y Apple — dejar vacío desactiva el botón correspondiente
# (el frontend lo muestra como "Próximamente" hasta que tengan valor).
# Ver docs/LOGIN-GOOGLE-APPLE-SETUP.md para cómo conseguirlos.
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=

# Recuperar PIN por email — dejar vacío desactiva "¿Olvidaste tu PIN?"
# (el backend responde 503 y no rompe el login por teléfono).
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
